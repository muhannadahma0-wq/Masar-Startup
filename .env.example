# Local PostgreSQL (create database masar first)
DATABASE_URL=postgresql://masar:masar@localhost:5432/masar
NODE_ENV=development

# OpenAI Responses API. Without a valid key/model access, AI review is explicitly unavailable.
MASAR_LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_AGENT_MODEL=gpt-6.1-sol
OPENAI_SYNTHESIS_MODEL=gpt-6-astra
MASAR_AGENT_CONCURRENCY=8
MASAR_AGENT_TIMEOUT_MS=10000
MASAR_SYNTHESIS_TIMEOUT_MS=14000

# Uploaded pitch files are stored locally in development. Render's ephemeral filesystem
# is not durable; configure S3-compatible storage or a persistent disk for production.
MASAR_STORAGE_DIR=storage/decks
